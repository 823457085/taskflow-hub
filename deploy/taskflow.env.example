# 复制为 /etc/taskflow/taskflow.env（root:taskflow，权限 0640）。不要提交真实凭据。
TASKFLOW_DEPLOYMENT=server
TASKFLOW_HOST=127.0.0.1
TASKFLOW_PORT=5187
TASKFLOW_DB_PATH=/var/lib/taskflow/platform.sqlite
# 仅当 API 只监听回环且前面是会覆盖 X-Real-IP 的 Nginx 时开启
TASKFLOW_TRUST_PROXY=1
# 服务器模式默认开启；只有在纯 HTTP 内网试运行时才设为 0
TASKFLOW_COOKIE_SECURE=1
# 创建首个管理员时网页需填写的初始化口令（至少 16 位随机串，例如 openssl rand -base64 24）。
# 管理员创建后即失效，可从文件中删除。
TASKFLOW_SETUP_TOKEN=
# 本机 Bridge 常驻进程的设备会话时长（小时，1..720）
TASKFLOW_DEVICE_SESSION_HOURS=168
# 允许派发到本机 Bridge 的处理方式：read,review[,develop]。develop 仍需成员本机 allowDevelop 且弹窗确认
TASKFLOW_BRIDGE_MODES=read,review

# 可选：管理员「复用服务器凭据」接入 Jira 服务账号（文件内为 JIRA_BASE_URL / JIRA_USERNAME / JIRA_API_TOKEN）
# TASKFLOW_JIRA_PROFILE=/etc/taskflow/jira.env
# TASKFLOW_CONFLUENCE_PROFILE=/etc/taskflow/confluence.env

# 可选：工作台的公网主机名或 IP，包含非默认的 HTTPS 端口。工作台网关仍监听回环端口。
# TASKFLOW_WORKBENCH_HOST=hub.example.com:80
# TASKFLOW_WORKBENCH_PORT=5189
# TASKFLOW_PUBLIC_ORIGIN=https://hub.example.com
